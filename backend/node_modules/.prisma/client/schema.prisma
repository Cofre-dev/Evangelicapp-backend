generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================================================
// ENUMS
// ==========================================================================

enum Rol {
  SUPER_ADMIN
  PASTOR
  TESORERO
  SECRETARIA
  MIEMBRO
}

enum EstadoIglesia {
  ACTIVA
  SUSPENDIDA
  INACTIVA
}

enum TipoEvento {
  CULTO
  REUNION
  LIMPIEZA
  OTRO
}

enum EstadoConfirmacionPredicador {
  PENDIENTE
  CONFIRMADO
  RECHAZADO
}

enum TipoMovimiento {
  INGRESO
  EGRESO
}

/// Solo distingue cómo se recibió/pagó la plata — no implica cajas ni cuentas separadas.
enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
}

enum AccionAuditoria {
  CREACION
  EDICION
  ELIMINACION
}

enum EstadoTarea {
  PENDIENTE
  /// El usuario asignado marcó la tarea como hecha; queda esperando que el pastor la apruebe.
  EN_REVISION
  COMPLETADA
}

enum TipoNota {
  RECORDATORIO
  NOTA
}

// ==========================================================================
// TENANT RAÍZ
// ==========================================================================

/// Cada fila es un tenant. Ninguna tabla transaccional existe sin apuntar aquí.
model Iglesia {
  id                 String        @id @default(cuid())
  nombre             String
  logoUrl            String?
  comuna             String
  region             String
  direccion          String?
  estado             EstadoIglesia @default(ACTIVA)
  /// Capturado en el onboarding del pastor; usado en dashboards y reportes.
  visitantesPromedio Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  usuarios              Usuario[]
  eventos               Evento[]
  categoriasFinancieras CategoriaFinanciera[]
  movimientos           MovimientoFinanciero[]
  auditoriasFinancieras MovimientoAuditLog[]
  notas                 Nota[]

  @@map("iglesias")
}

// ==========================================================================
// USUARIOS Y AUTH
// ==========================================================================

/// SUPER_ADMIN es el único rol con iglesiaId nulo (opera fuera de cualquier tenant).
/// Todos los demás roles quedan atados a exactamente una iglesia.
model Usuario {
  id                   String   @id @default(cuid())
  /// Credencial de login. El email se mantiene como dato de contacto (notificaciones,
  /// recuperación de cuenta), pero ya no es lo que se usa para autenticarse.
  username             String   @unique
  email                String   @unique
  password             String
  nombre               String
  apellido             String
  telefono             String?
  rol                  Rol
  mustChangePassword   Boolean  @default(true)
  onboardingCompletado Boolean  @default(false)
  activo               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  iglesiaId String?
  iglesia   Iglesia? @relation(fields: [iglesiaId], references: [id], onDelete: Cascade)

  eventosCreados        Evento[]               @relation("EventoCreadoPor")
  movimientosCreados    MovimientoFinanciero[] @relation("MovimientoCreadoPor")
  auditoriasFinancieras MovimientoAuditLog[]   @relation("AuditoriaRealizadaPor")
  notasCreadas          Nota[]                 @relation("NotaCreadaPor")
  notasAsignadas        Nota[]                 @relation("NotaAsignadaA")
  refreshTokens         RefreshToken[]

  @@index([iglesiaId])
  @@map("usuarios")
}

/// Habilita rotación/revocación de refresh tokens (logout real, no solo expiración).
model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

// ==========================================================================
// MÓDULO 1 — AGENDA
// ==========================================================================

model Evento {
  id            String     @id @default(cuid())
  titulo        String
  descripcion   String?
  tipo          TipoEvento
  fechaInicio   DateTime
  fechaFin      DateTime
  ubicacion     String?
  colorEtiqueta String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  iglesiaId String
  iglesia   Iglesia @relation(fields: [iglesiaId], references: [id], onDelete: Cascade)

  creadoPorId String?
  creadoPor   Usuario? @relation("EventoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  predicadores Predicador[]

  @@index([iglesiaId, fechaInicio])
  @@map("eventos")
}

/// Solo aplica cuando Evento.tipo = CULTO. El token público permite
/// confirmar/rechazar desde el email sin necesitar cuenta en la plataforma.
model Predicador {
  id                String                       @id @default(cuid())
  nombre            String?
  email             String
  tokenConfirmacion String                       @unique @default(cuid())
  estado            EstadoConfirmacionPredicador @default(PENDIENTE)
  respondidoAt      DateTime?
  createdAt         DateTime                     @default(now())

  eventoId String
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([eventoId])
  @@map("predicadores")
}

// ==========================================================================
// MÓDULO 2 — FINANZAS
// ==========================================================================

/// Categorías propias por iglesia (ej. Diezmos, Ofrendas, Arriendo, Servicios).
model CategoriaFinanciera {
  id        String         @id @default(cuid())
  nombre    String
  tipo      TipoMovimiento
  createdAt DateTime       @default(now())

  iglesiaId String
  iglesia   Iglesia @relation(fields: [iglesiaId], references: [id], onDelete: Cascade)

  movimientos MovimientoFinanciero[]

  @@unique([iglesiaId, nombre, tipo])
  @@map("categorias_financieras")
}

model MovimientoFinanciero {
  id          String         @id @default(cuid())
  tipo        TipoMovimiento
  monto       Decimal        @db.Decimal(12, 2)
  /// Obligatoria: cada movimiento debe quedar trazable en qué se gastó o de dónde vino.
  descripcion String
  /// Solo diferencia efectivo de transferencia — no representa cajas ni cuentas separadas.
  medioPago   MedioPago      @default(EFECTIVO)
  fecha       DateTime
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  iglesiaId String
  iglesia   Iglesia @relation(fields: [iglesiaId], references: [id], onDelete: Cascade)

  categoriaId String
  categoria   CategoriaFinanciera @relation(fields: [categoriaId], references: [id])

  creadoPorId String?
  creadoPor   Usuario? @relation("MovimientoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([iglesiaId, fecha])
  @@map("movimientos_financieros")
}

/// Historial inmutable de creación/edición/eliminación de movimientos. El snapshot
/// guarda los datos del movimiento en ese momento porque, si se elimina, la fila
/// original deja de existir y este es el único registro que queda de ella.
model MovimientoAuditLog {
  id        String          @id @default(cuid())
  accion    AccionAuditoria
  createdAt DateTime        @default(now())

  iglesiaId String
  iglesia   Iglesia @relation(fields: [iglesiaId], references: [id], onDelete: Cascade)

  /// Sin relación FK: el movimiento referenciado puede ya no existir (ELIMINACION).
  movimientoId String

  usuarioId String?
  usuario   Usuario? @relation("AuditoriaRealizadaPor", fields: [usuarioId], references: [id], onDelete: SetNull)

  snapshot Json

  @@index([iglesiaId, createdAt])
  @@map("movimientos_auditoria")
}

// ==========================================================================
// MÓDULO 3 — NOTAS / TAREAS
// ==========================================================================

model Nota {
  id          String      @id @default(cuid())
  /// RECORDATORIO: tarea corta con fecha límite, asignable. NOTA: texto libre del pastor, sin asignación.
  tipo        TipoNota    @default(RECORDATORIO)
  titulo      String
  descripcion String?
  fechaLimite DateTime?
  estado      EstadoTarea @default(PENDIENTE)
  notificado  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  iglesiaId String
  iglesia   Iglesia @relation(fields: [iglesiaId], references: [id], onDelete: Cascade)

  creadoPorId String
  creadoPor   Usuario @relation("NotaCreadaPor", fields: [creadoPorId], references: [id])

  asignadoAId String?
  asignadoA   Usuario? @relation("NotaAsignadaA", fields: [asignadoAId], references: [id], onDelete: SetNull)

  @@index([iglesiaId, fechaLimite])
  @@map("notas")
}
