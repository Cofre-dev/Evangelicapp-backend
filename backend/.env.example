DATABASE_URL="postgresql://user:password@localhost:5432/evangelicapp"
PORT=3001
# Uno o varios orígenes separados por coma (sin espacios extra al final). Requerido:
# las cookies de auth exigen credentials:true en el fetch, lo que prohíbe origin:"*".
CORS_ORIGIN="http://localhost:3000"

# En "production" las cookies de auth se marcan Secure (solo viajan por HTTPS).
NODE_ENV="development"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRATION="7d"

FRONTEND_URL="http://localhost:3000"
SMTP_HOST="localhost"
SMTP_PORT=1025
MAIL_FROM="Evangelicapp <noreply@evangelicapp.cl>"
