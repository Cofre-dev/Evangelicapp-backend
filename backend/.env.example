DATABASE_URL="postgresql://user:password@localhost:5432/evangelicapp"
PORT=3001
# Uno o varios orígenes separados por coma (sin espacios extra al final). Requerido:
# las cookies de auth exigen credentials:true en el fetch, lo que prohíbe origin:"*".
CORS_ORIGIN="http://localhost:3000"

# En "production" las cookies de auth se marcan Secure (solo viajan por HTTPS).
NODE_ENV="development"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRATION="7d"

FRONTEND_URL="http://localhost:3000"
# Usado para construir URLs absolutas dentro de correos (ej. el logo de la iglesia
# en la convocatoria de eventos) — un <img> en un email no puede usar una ruta relativa.
BACKEND_URL="http://localhost:3001"
SMTP_HOST="localhost"
SMTP_PORT=1025
MAIL_FROM="Evangelicapp <noreply@evangelicapp.cl>"

# 'smtp' (default, usa SMTP_HOST/SMTP_PORT vía Nodemailer) o 'resend'.
MAIL_PROVIDER="smtp"
# Solo se usa si MAIL_PROVIDER=resend. En modo sandbox (sin dominio propio verificado
# en Resend), el remitente onboarding@resend.dev solo entrega al correo del dueño de
# la cuenta — ver nota en FEATURES.md antes de usar esto en producción.
RESEND_API_KEY=""
